# Profile parameters for the first Siemens Windows 11 VM.
# This file is sourced by win11-first-vm.sh; callers can override any value
# with the corresponding WIN11_FIRST_* environment variable or an optional
# WIN11_FIRST_ENV_FILE.

export VM_NAME="${WIN11_FIRST_VM_NAME:-win11-siemens}"
export WIN11_DOMAIN_UUID="${WIN11_FIRST_DOMAIN_UUID:-e39af3f0-0d5f-4932-8934-9fe33d19ce86}"
export WIN11_SMBIOS_SERIAL="${WIN11_FIRST_SMBIOS_SERIAL:-WIN11-E39AF3F00D5F493289349FE33D19CE86}"
export WIN11_DISK_SERIAL="${WIN11_FIRST_DISK_SERIAL:-WIN11-E39AF3F00D5F493289349FE33D19CE86-DISK}"
export WIN11_MAC="${WIN11_FIRST_MAC:-52:54:00:df:a5:d1}"
export WIN11_ZVOL="${WIN11_FIRST_ZVOL:-zpcachyos/vms/win11}"
export WIN11_DISK_BACKEND="${WIN11_FIRST_DISK_BACKEND:-zvol}"
export WIN11_DISK_PATH="${WIN11_FIRST_DISK_PATH:-}"
export WIN11_VOLSIZE="${WIN11_FIRST_VOLSIZE:-128G}"
export WIN11_ZVOL_VOLBLOCKSIZE="${WIN11_FIRST_ZVOL_VOLBLOCKSIZE:-16K}"
export WIN11_ZVOL_SPARSE="${WIN11_FIRST_ZVOL_SPARSE:-0}"
export WIN11_VENTOY_ISO_DIR="${WIN11_FIRST_VENTOY_ISO_DIR:-/run/media/${USER}/Ventoy/ISO/Imported}"
export WIN11_ISO_PATH="${WIN11_FIRST_ISO_PATH:-/var/lib/libvirt/boot/Windows11-25H2-Official-Multi-DE.iso}"
export WIN11_SUPPORT_ISO="${WIN11_FIRST_SUPPORT_ISO:-/var/lib/libvirt/boot/win11-siemens-autounattend.iso}"
export VIRTIO_ISO_PATH="${WIN11_FIRST_VIRTIO_ISO_PATH:-/var/lib/libvirt/boot/virtio-win.iso}"
export WIN11_COMPRESSION="${WIN11_FIRST_COMPRESSION:-zstd-3}"
export WIN11_SYNC="${WIN11_FIRST_SYNC:-disabled}"
export WIN11_PRIMARYCACHE="${WIN11_FIRST_PRIMARYCACHE:-metadata}"
export WIN11_RAM_MIB="${WIN11_FIRST_RAM_MIB:-16384}"
export WIN11_VCPUS="${WIN11_FIRST_VCPUS:-6}"
export WIN11_CPU_SOCKETS="${WIN11_FIRST_CPU_SOCKETS:-1}"
export WIN11_CPU_CORES="${WIN11_FIRST_CPU_CORES:-6}"
export WIN11_CPU_THREADS="${WIN11_FIRST_CPU_THREADS:-1}"
export WIN11_CPU_MODE="${WIN11_FIRST_CPU_MODE:-host-passthrough}"
export WIN11_NETWORK_MODEL="${WIN11_FIRST_NETWORK_MODEL:-e1000e}"
export WIN11_DISK_BUS="${WIN11_FIRST_DISK_BUS:-sata}"
export WIN11_CACHE_MODE="${WIN11_FIRST_CACHE_MODE:-none}"
export WIN11_IO_MODE="${WIN11_FIRST_IO_MODE:-io_uring}"
export WIN11_DISCARD_MODE="${WIN11_FIRST_DISCARD_MODE:-unmap}"
export WIN11_DETECT_ZEROES="${WIN11_FIRST_DETECT_ZEROES:-unmap}"
export WIN11_BOOT_FROM_ISO="${WIN11_FIRST_BOOT_FROM_ISO:-1}"
export WIN11_SECURE_BOOT="${WIN11_FIRST_SECURE_BOOT:-1}"
export WIN11_TPM_MODEL="${WIN11_FIRST_TPM_MODEL:-tpm-crb}"
export WIN11_OS_VARIANT="${WIN11_FIRST_OS_VARIANT:-win11}"
export WIN11_ENROLL_SECURE_BOOT_KEYS="${WIN11_FIRST_ENROLL_SECURE_BOOT_KEYS:-1}"
export WIN11_REQUIRE_PATCHED_ISO="${WIN11_FIRST_REQUIRE_PATCHED_ISO:-0}"
export WIN11_SNAPSHOT_BEFORE_START="${WIN11_FIRST_SNAPSHOT_BEFORE_START:-1}"
export WIN11_IMAGE_INDEX="${WIN11_FIRST_IMAGE_INDEX:-6}"
export WIN11_ENROLLED_VARS_TEMPLATE="${WIN11_FIRST_ENROLLED_VARS_TEMPLATE:-/var/lib/libvirt/boot/OVMF_VARS.4m.ms-enrolled.fd}"
export WIN11_DISABLE_PCI_PASSTHROUGH=1
export WIN11_PCI_HOSTDEV_BDF=""
export WIN11_PCI_HOSTDEV_IFACE=""
export WIN11_PCI_HOSTDEV_AUTO=0
export WIN11_PCI_WATCHER=0
