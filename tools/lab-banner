#!/usr/bin/env bash
# lab-banner – Miniatur-Status beim Login (voll: 'lab'). Quelle: cachyos-kvm-lab/tools/lab-banner
# Rekursionsschutz: LAB_QUIET wird gesetzt, falls dieses Skript aus einer login-shell kommt.
export LAB_QUIET=1
R=/home/z000g9hu/work/cachyos-kvm-lab
L=/home/z000g9hu/vm-lab
K=$(grep -m1 LITELLM_MASTER_KEY ~/.config/litellm/.env 2>/dev/null | cut -d= -f2)
{ curl -s --max-time 1.5 -o /dev/null http://127.0.0.1:8001/health && P=$'\033[32m▲pennyroyal\033[0m' || P=$'\033[31m▼pennyroyal\033[0m'
  curl -s --max-time 1.5 -H "Authorization: Bearer $K" -o /dev/null http://127.0.0.1:4000/v1/models && M=$'\033[32m▲litellm\033[0m' || M=$'\033[31m▼litellm\033[0m'
  curl -s --max-time 1.5 -o /dev/null http://127.0.0.1:8080/health && B=$'\033[32m▲bonsai\033[0m' || B=$'\033[33m○bonsai\033[0m'
  V=$(sudo -n virsh list --name --state-running 2>/dev/null | paste -sd, - | sed 's/^/VMs: /;s/^VMs: $/VMs: keine/')
  WM=$(sudo -n journalctl -k -b --no-pager 2>/dev/null | grep -ci vmwrite || true); WM=${WM:-?}
  BB="vmvga:keins"
  grep -q 'BUILD_RC=0' "$L/vmvga/BUILD_ninja.log" 2>/dev/null && BB=$'\033[32mvmvga:FERTIG ✔\033[0m'
  [ "$BB" = "vmvga:keins" ] && [ -f "$L/vmvga/BUILD_ninja.log" ] && BB="vmvga:$(grep -oE '\[[0-9]+/[0-9]+\]' "$L/vmvga/BUILD_ninja.log" | tail -1)"
  [ "$BB" = "vmvga:keins" ] && [ -f "$L/vmvga/BUILD_config.log" ] && BB="vmvga:configure"
  NB=$(awk '/## Reboot-Liste/{f=1;next} f&&/^## /{exit} f' "$R/TODO.md" 2>/dev/null | grep -cE '^[[:space:]]*[0-9]+\.')
} 2>/dev/null
printf '\033[1;34m┌─ P16-Labor \033[0m %s %s %s │ %s │ KVM-vmwrite:%s │ %s │ nächste Schritte:%s\n' "$P" "$M" "$B" "$V" "$WM" "$BB" "$NB"
[ "$WM" != "0" ] && printf '\033[31m│\033[0m  ⚠ KVM vmwrite-Fehler diesen Boot → keine neuen VM-Starts, Reboot planen\n'
printf '\033[34m└─\033[0m ausführlich: \033[1mlab\033[0m · Wiki: \033[1mlab wiki\033[0m · Browser: \033[1mlab web\033[0m · Handoff: %s\n\n' "$R/TODO.md"
